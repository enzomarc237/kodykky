{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scaffold AI",
  "version": "0.1.0",
  "identifier": "com.scaffoldai.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Scaffold AI",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Scaffold AI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png", 
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["templates/**/*"],
    "externalBin": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "",
    "longDescription": "",
    "deb": {
      "depends": []
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "depends": ["openjdk-8-jdk"]
      },
      "appimage": {
        "args": []
      },
      "fileMenu": [],
      "desktopTemplate": null
    }
  },
  "plugins": {
    "fs": {
      "scope": {
        "allow": ["**/*"]
      },
      "fileDragDrop": {
        "maxFileSize": 100000000,
        "hint": "drag and drop files"
      }
    }
  }
}
